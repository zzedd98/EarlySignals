# Database
POSTGRES_USER=earlysignals
POSTGRES_PASSWORD=earlysignals_dev
POSTGRES_DB=earlysignals
DATABASE_URL=postgresql://earlysignals:earlysignals_dev@localhost:5433/earlysignals

# Redis
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey_dev_change_in_prod

# API
API_URL=http://localhost:8000
API_SECRET_KEY=change_this_secret_key_in_production
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL du frontend pour la redirection après connexion Google
FRONTEND_URL=http://localhost:4200

# Email (SMTP - production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@earlysignals.io
SMTP_FROM_NAME=Early Signals

# Email (development - MailHog)
SMTP_HOST_DEV=localhost
SMTP_PORT_DEV=1025

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# LLM (OpenAI or other)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# Scraper
# Scraper (rate limit Redis retiré — ne plus utiliser)
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_PARALLELISM=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_API_EMAIL=admin@example.com
SCRAPER_API_PASSWORD=admin123456
# Scraper workers : 14 terminaux → ~94 domaines/worker pour 1307 domaines
SCRAPER_WORKER_COUNT=14
# Batch manuel si tu lances un seul --worker-index (launch:terminals calcule auto)
SCRAPER_BATCH_SIZE=400
# Fichier Lightning (host:port:user:password) — même format que seed_builder
SCRAPER_PROXIES_FILE=../seed_builder_prospects/data/proxies.lightning.txt
# Garder les terminaux workers ouverts après le crawl (Entrée pour fermer)
SCRAPER_KEEP_OPEN=true
# Snapshots par requête POST /snapshots/bulk (évite erreur 500 payload too large)
SCRAPER_BULK_CHUNK_SIZE=20

# Scraper browser settings
SCRAPER_HEADLESS=false
SCRAPER_BROWSER=chromium
SCRAPER_MAX_CONCURRENT_PATHS=1
# Gros sites : pas de discovery, uniquement les working_paths (à renseigner en BDD). Ex: laredoute.fr,manomano.fr
SCRAPER_LARGE_DOMAINS=
# Découverte carrières via Google (recherche "domaine + careers", premier lien pertinent). Mettre à true pour l’activer (désactivé par défaut).
SCRAPER_USE_GOOGLE_CAREERS_DISCOVERY=false
# Proxies pour rotation d’IP (un contexte par proxy, rotation par domaine). Ex: http://127.0.0.1:101,http://127.0.0.1:102
SCRAPER_PROXIES=
# Mode HTTP simple pour les working_paths (GET comme le seed_builder). Mettre à false pour repasser en mode Playwright uniquement.
SCRAPER_HTTP_MODE_FOR_WORKING_PATHS=true
# Normalisation HTML : supprime timestamps, IDs aléatoires, etc. pour un hash plus stable (réduit les faux positifs de changement)
SCRAPER_NORMALIZE_HTML=true
# Extraction de contenu stable : utilise uniquement le contenu principal (main, article, etc.) pour le hash (ignore headers/footers/ads)
SCRAPER_EXTRACT_STABLE_CONTENT=true

# Worker
WORKER_BATCH_SIZE=10
WORKER_SCORE_THRESHOLD_INSTANT_NOTIF=70

# Frontend
VITE_API_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
DEBUG=true
